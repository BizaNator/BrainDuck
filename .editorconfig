# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# TypeScript and JavaScript files
[*.{ts,js,tsx,jsx}]
indent_style = space
indent_size = 2
max_line_length = 100

# JSON files
[*.json]
indent_style = space
indent_size = 2

# Lua files
[*.lua]
indent_style = space
indent_size = 4
max_line_length = 120
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
quote_style = double
continuation_indent = 8
align_args = true
align_parameter = true
align_table_field = true
keep_comments = true
break_after_comment = true

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Web files
[*.{html,css,scss}]
indent_style = space
indent_size = 2

# Config files
[{package.json,.travis.yml,.vscode/*.json}]
indent_style = space
indent_size = 2

# Migration and SQL files
[*.{sql,duckdb}]
indent_style = space
indent_size = 2
