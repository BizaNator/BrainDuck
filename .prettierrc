{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "tabWidth": 2,
  "printWidth": 100,
  "arrowParens": "avoid",
  "endOfLine": "auto",
  "overrides": [
    {
      "files": ["*.lua"],
      "options": {
        "parser": "lua",
        "tabWidth": 4,
        "singleQuote": false,
        "trailingComma": "none",
        "bracketSpacing": true,
        "endOfLine": "lf"
      },
      "plugins": ["prettier-plugin-lua"]
    },
    {
      "files": ["*.json", "*.md"],
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
