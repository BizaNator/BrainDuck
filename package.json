{
  "name": "duckdb-handler",
  "version": "1.0.0",
  "description": "FiveM DuckDB handler with MySQL compatibility",
  "main": "server/index.js",
  "scripts": {
    "test": "mocha tests/**/*.test.js",
    "build": "cd web && npm install && npm run build",
    "postinstall": "cd web && npm install",
    "dev": "concurrently \"cd web && npm start\" \"nodemon server/index.js\"",
    "start": "node server/index.js"
  },
  "dependencies": {
    "duckdb": "^0.9.1",
    "fivem-server-utils": "^1.0.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "mysql2": "^3.6.1"
  },
  "devDependencies": {
    "mocha": "^10.2.0",
    "chai": "^4.3.10",
    "concurrently": "^8.2.1",
    "nodemon": "^3.0.1"
  },
  "bin": {
    "duckdb-migrate": "./tools/migrate.js"
  }
}
