{
  "name": "duckdb-handler",
  "version": "1.0.0",
  "description": "FiveM DuckDB handler with MySQL compatibility",
  "main": "server/index.js",
  "scripts": {
    "test": "mocha tests/**/*.test.js",
    "build": "npm run validate-env && npm run clean && npm run format && npm run lint && npm run build:all",
    "build:all": "npm run build:ts && npm run build:web && npm run build:lua",
    "build:ts": "tsc",
    "build:web": "cd web && npm install && npm run build",
    "build:lua": "luac -p client/*.lua && luac -p server/*.lua",
    "verify:lua": "luac -p -v client/*.lua server/*.lua",
    "validate-env": "node tools/validate-env.js",
    "validate": "npm run validate-env && npm run verify:lua && npm run luacheck",
    "postinstall": "cd web && npm install",
    "dev": "concurrently \"npm run dev:ts\" \"npm run dev:web\" \"npm run dev:server\"",
    "dev:ts": "tsc --watch",
    "dev:web": "cd web && npm start",
    "dev:server": "nodemon dist/server/index.js",
    "start": "node dist/server/index.js",
    "clean": "rimraf dist",
    "lint": "npm run lint:js && npm run lint:lua && npm run luacheck",
    "lint:js": "eslint . --ext .ts,.js",
    "lint:lua": "eslint . --ext .lua",
    "lint:fix": "npm run lint:js:fix && npm run lint:lua:fix",
    "lint:js:fix": "eslint . --ext .ts,.js --fix",
    "lint:lua:fix": "eslint . --ext .lua --fix",
    "luacheck": "luacheck client/ server/ --config .luacheckrc",
    "luacheck:fix": "luacheck client/ server/ --config .luacheckrc --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\" && npm run format:lua",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\" && npm run format:lua:check",
    "format:lua": "prettier --write \"**/*.lua\" --plugin=prettier-plugin-lua",
    "format:lua:check": "prettier --check \"**/*.lua\" --plugin=prettier-plugin-lua",
    "type-check": "tsc --noEmit",
    "prepare": "npm run build",
    "migrate": "node tools/migrate.js",
    "migrate:verify": "node tools/verify.js",
    "migrate:all": "npm run migrate && npm run migrate:verify",
    "migrate:init": "cp migration-config.example.json migration-config.json",
    "backup": "node tools/backup.js",
    "backup:list": "node tools/backup.js list",
    "backup:create": "node tools/backup.js create",
    "db:status": "node -e \"require('./tools/verify.js').verify()\"",
    "db:info": "node -e \"require('./tools/backup.js').listBackups(); require('./tools/verify.js').verify()\"",
    "schema:create": "node tools/schema.js create",
    "schema:migrate": "node tools/schema.js migrate",
    "schema:verify": "node tools/schema.js verify",
    "schema:status": "node tools/schema.js status",
    "db:setup": "npm run migrate:init && npm run migrate:all && npm run schema:migrate"
  },
  "dependencies": {
    "duckdb": "^0.9.1",
    "@citizenfx/server": "*",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "mysql2": "^3.6.1",
    "luaparse": "^0.3.1",
    "lua-formatter": "^0.1.4"
  },
  "devDependencies": {
    "mocha": "^10.2.0",
    "prettier-plugin-lua": "^0.1.0",
    "eslint-plugin-lua": "^2.3.0",
    "luacheck": "^1.1.1",
    "@types/fivem-js": "^1.5.4",
    "chai": "^4.3.10",
    "concurrently": "^8.2.1",
    "nodemon": "^3.0.1",
    "typescript": "^5.2.2",
    "@types/node": "^20.8.0",
    "@citizenfx/client": "*",
    "@citizenfx/server": "*",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "eslint": "^8.49.0",
    "prettier": "^3.0.3",
    "rimraf": "^5.0.1",
    "@types/mocha": "^10.0.1",
    "@types/chai": "^4.3.6"
  },
  "bin": {
    "duckdb-migrate": "./tools/migrate.js"
  },
  "types": "types/index.d.ts",
  "files": [
    "server",
    "client",
    "web/build",
    "types",
    "tools"
  ],
  "engines": {
    "node": ">=16.0.0"
  }
}
