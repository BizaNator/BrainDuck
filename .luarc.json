{
  "$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT"
  },
  "workspace": {
    "library": [
      "${3rd}/CFXLua/library",
      "${3rd}/FiveM/library"
    ],
    "checkThirdParty": false
  },
  "diagnostics": {
    "globals": [
      "source",
      "GetCurrentResourceName",
      "RegisterCommand",
      "RegisterNetEvent",
      "AddEventHandler",
      "TriggerEvent",
      "TriggerClientEvent",
      "TriggerServerEvent",
      "IsPlayerAceAllowed",
      "PlayerId",
      "SetNuiFocus",
      "SendNUIMessage",
      "RegisterNUICallback"
    ]
  }
}
