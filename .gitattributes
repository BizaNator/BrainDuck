# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Source code
*.js    text diff=javascript
*.ts    text diff=typescript
*.json  text
*.lua   text
*.md    text diff=markdown
*.html  text diff=html
*.css   text diff=css
*.sql   text

# Documentation
*.txt   text
*.pdf   binary
*.doc   binary
*.docx  binary

# Graphics
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.svg   text

# DuckDB files
*.duckdb binary
*.duckdb-wal binary
*.duckdb-shm binary

# Scripts
*.sh    text eol=lf
*.bat   text eol=crlf

# Configuration
*.yml   text
*.yaml  text
*.conf  text
.env*   text
.editor* text

# FiveM specific
fxmanifest.lua text
*.toml text

# Exclude files from exporting
.gitattributes export-ignore
.gitignore     export-ignore
.gitkeep       export-ignore

# Mark files as generated to exclude from language statistics
web/build/**   linguist-generated=true
dist/**        linguist-generated=true
